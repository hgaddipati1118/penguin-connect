# PenguinConnect environment
# Copy this file to .env
#   cp .env.example .env

# Local bridge API port (default 9000)
PENGUIN_CONNECT_PORT=9000

# Local data directory and SQLite DB path
# PENGUIN_CONNECT_DATA_DIR=~/penguinconnect-local-bridge-data
# PENGUIN_CONNECT_DB_PATH=~/penguinconnect-local-bridge-data/cache.db

# Poll interval in seconds for incremental sync (default 30)
PENGUIN_CONNECT_POLL_SECONDS=30

# Optional explicit cap for each incremental sync run. Leave unset to let
# incremental batches expand to cover all currently hot conversations up to the
# built-in cap.
# PENGUIN_CONNECT_INCREMENTAL_CONVERSATIONS_PER_RUN=5

# Optional cap for startup catch-up. Leave unset to drain all pending bootstrap conversations on server start.
# PENGUIN_CONNECT_STARTUP_CATCHUP_CONVERSATIONS_PER_RUN=5

# While startup/backfill is importing iMessage history, yield to queued
# incremental work after this many successful Gmail imports.
# PENGUIN_CONNECT_STARTUP_INCREMENTAL_PREEMPTION_IMPORT_COUNT=5

# iMessage -> Gmail backfill pacing (base seconds between Gmail writes in backfill/startup modes; default 0.15).
# After repeated Gmail rate limits, PenguinConnect now increases this pause automatically up to 5 seconds.
PENGUIN_CONNECT_BACKFILL_WRITE_PAUSE_SECONDS=0.15
# Per-user Gmail write budget. Backfill/startup must also fit inside the smaller backfill bucket,
# which leaves the rest of the budget available for incremental work.
PENGUIN_CONNECT_GMAIL_WRITE_BUDGET_UNITS_PER_MINUTE=3000
PENGUIN_CONNECT_GMAIL_BACKFILL_WRITE_BUDGET_UNITS_PER_MINUTE=1200
# Quota units charged per local Gmail write reservation (defaults to 25 to match Gmail import/insert writes).
PENGUIN_CONNECT_GMAIL_WRITE_OPERATION_COST_UNITS=25
# Optional rolling 24-hour cap for startup/backfill Gmail imports. Incremental sync is exempt.
# PENGUIN_CONNECT_BACKFILL_DAILY_GMAIL_IMPORT_CAP=500
# If startup/backfill keeps tripping Gmail rate limits, stand those modes down once the streak hits this threshold.
# PENGUIN_CONNECT_BACKFILL_RATE_LIMIT_GUARD_STREAK=8
# How long startup/backfill should stay paused after the guard trips (default 3600 seconds).
# PENGUIN_CONNECT_BACKFILL_RATE_LIMIT_GUARD_PAUSE_SECONDS=3600

# Base/max cooldown when Gmail rate limits sync work (defaults 120/1800).
# PenguinConnect applies exponential backoff between those bounds across repeated rate-limit hits.
PENGUIN_CONNECT_GMAIL_RATE_LIMIT_PAUSE_SECONDS=120
PENGUIN_CONNECT_GMAIL_RATE_LIMIT_MAX_PAUSE_SECONDS=1800

# Durable sync queue (survives process pauses/restarts)
# Max attempts before marking sync job failed (default 12)
PENGUIN_CONNECT_SYNC_JOB_MAX_ATTEMPTS=12
# Lease timeout in seconds before another worker can resume a stuck job (default 180)
PENGUIN_CONNECT_SYNC_JOB_LEASE_SECONDS=180
# Retry backoff base/max in seconds for failed sync jobs (defaults 30/1800)
PENGUIN_CONNECT_SYNC_JOB_RETRY_BASE_SECONDS=30
PENGUIN_CONNECT_SYNC_JOB_RETRY_MAX_BACKOFF_SECONDS=1800
# Terminal jobs retained per status for local diagnostics (default 200)
PENGUIN_CONNECT_SYNC_JOB_HISTORY_LIMIT=200

# Retry/backoff policy for failed cross-channel deliveries
# Base retry delay in seconds (default 30)
PENGUIN_CONNECT_RETRY_BASE_SECONDS=30
# Max exponential backoff delay in seconds (default 900)
PENGUIN_CONNECT_RETRY_MAX_BACKOFF_SECONDS=900
# Max retry attempts per message before marking failed_permanent (default 8)
PENGUIN_CONNECT_MAX_RETRIES=8
# Max retry attempts for Gmail-to-chat delivery before posting a failure notice (default 3)
PENGUIN_CONNECT_GMAIL_TO_SOURCE_MAX_RETRIES=3

# Max iMessage chats discovered into conversation mapping (default 500)
PENGUIN_CONNECT_CHAT_DISCOVERY_LIMIT=500

# Safety window before stale alias-only Gmail drafts in non-canonical threads are deleted (default 30 minutes)
# PENGUIN_CONNECT_ALIAS_DRAFT_DELETE_MINUTES=30

# Step 1: Google OAuth Desktop JSON path override (optional)
# PENGUIN_CONNECT_GOOGLE_CLIENT_SECRETS=~/penguinconnect-local-bridge-data/google_client_secret.json

# Optional path to a local JSON file containing custom email signature/disclaimer cutoff markers.
# The default path is ./.penguin_connect_signature_markers.json
# See ./signature_markers.example.json for file format.
# PENGUIN_CONNECT_SIGNATURE_MARKERS_FILE=/abs/path/to/signature_markers.json

# Optional path to a local JSON file containing Apple Messages chats/conversations
# that PenguinConnect should exclude from discovery and sync.
# The default path is ./.penguin_connect_excluded_chats.json
# See ./excluded_chats.example.json for file format.
# PENGUIN_CONNECT_EXCLUDED_CHATS_FILE=/abs/path/to/excluded_chats.json

# WhatsApp adapter (requires the whatsapp-mcp Go bridge running at localhost:8080)
# Path to the WhatsApp bridge SQLite database
# PENGUIN_CONNECT_WHATSAPP_DB_PATH=~/whatsapp-mcp/whatsapp-bridge/store/messages.db
# PENGUIN_CONNECT_GIPHY_API_KEY=
# PENGUIN_CONNECT_AGENT_FILE_SEARCH_ROOTS=~
# WhatsApp bridge API URL for sending messages
# PENGUIN_CONNECT_WHATSAPP_API_URL=http://localhost:8080/api

# Telegram adapter (requires Telethon + one-time authentication)
# Get credentials from https://my.telegram.org → API development tools
# PENGUIN_CONNECT_TELEGRAM_API_ID=
# PENGUIN_CONNECT_TELEGRAM_API_HASH=
# Path to Telethon session file (default: ~/penguin-connect-data/telegram)
# PENGUIN_CONNECT_TELEGRAM_SESSION_PATH=~/penguin-connect-data/telegram

# Slack adapter (Slack Web API)
# Prefer a user token with channels/groups/im/mpim read + history, users:read,
# search:read, chat:write, and reactions:write scopes. Penguin reads its user token from macOS
# Keychain by default. PENGUIN_CONNECT_SLACK_TOKEN is a local override only.
# PENGUIN_CONNECT_SLACK_TOKEN=xoxp-...
# Recent workspace-wide seed used to sort populated channels without fetching every
# channel history individually (defaults: 30 days / 200 matching messages).
# PENGUIN_CONNECT_SLACK_SEED_DAYS=30
# PENGUIN_CONNECT_SLACK_SEED_MESSAGES=200
# Reuse an identical workspace discovery result briefly to avoid redundant API scans.
# PENGUIN_CONNECT_SLACK_DISCOVERY_MIN_SECONDS=45
# Bound conversations.history pagination because current Slack limits can be strict.
# PENGUIN_CONNECT_SLACK_HISTORY_PAGES=1
# Reuse an identical channel-history query for at least this long (default 60s).
# PENGUIN_CONNECT_SLACK_HISTORY_MIN_SECONDS=60

# Optional Codex prompt helper. Run `codex login` on this Mac for ChatGPT/Codex
# subscription auth; PenguinConnect only checks status and runs local `codex exec`.
# PENGUIN_CONNECT_CODEX_BIN=codex
# PENGUIN_CONNECT_CODEX_TIMEOUT_SECONDS=90
# PENGUIN_CONNECT_CODEX_MAX_PROMPT_CHARS=24000
# Coordination root exposed to the sidebar agent. Read mode stays sandboxed;
# edit and PR modes require explicit confirmation in the UI.
# PENGUIN_CONNECT_CODEX_WORKSPACE=/absolute/path/to/slashy

# Optional local API base override used by scripts/penguin_connect_doctor.py
# PENGUIN_CONNECT_LOCAL_API_BASE=http://127.0.0.1:9000

# Authenticated Streamable HTTP MCP endpoint. The server always binds to loopback;
# publish it through Cloudflare Tunnel rather than opening this port directly.
# PENGUIN_CONNECT_MCP_HOST=127.0.0.1
# PENGUIN_CONNECT_MCP_PORT=8765
# The bearer token lives in macOS Keychain. Do not put it in this file.
# PENGUIN_CONNECT_CLOUDFLARE_TUNNEL=penguin-connect-mcp
# PENGUIN_CONNECT_CLOUDFLARE_CONFIG=~/.cloudflared/config.yml

# Bootstrap only: temporarily allow startup before Gmail OAuth is connected.
# Do not leave this enabled for normal operation.
# PENGUIN_CONNECT_ALLOW_MISSING_GMAIL_STARTUP=1
